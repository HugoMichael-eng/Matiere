{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "S2 Design System — Matière. Editorial Void aesthetic: pure black and white tension with a single cold muted lavender-steel accent. Single-typeface system — Jost only, extreme weight and scale contrast. Zero radius throughout. Edit values here only; never hand-edit the generated src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FFFFFF", "$description": "Pure white. The void." },
      "foreground": { "$value": "#0C0C0C", "$description": "Near-black. Maximum contrast." },
      "border": { "$value": "#DEDEDE", "$description": "Cold light grey border." },
      "card": { "$value": "#F6F6F6", "$description": "Off-white card surface." },
      "cardForeground": { "$value": "#0C0C0C" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#0C0C0C" },
      "primary": {
        "$value": "#0C0C0C",
        "$description": "Pure black — the primary action. No colour, only weight."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#EFEFEF", "$description": "Light grey secondary surface." },
      "secondaryForeground": { "$value": "#0C0C0C" },
      "muted": { "$value": "#E8E8E8", "$description": "Muted surface — slightly darker than secondary." },
      "mutedForeground": { "$value": "#6E6E6E", "$description": "Mid grey text — restrained, never loud." },
      "accent": {
        "$value": "#B0AAB8",
        "$description": "Cold muted lavender-steel. The system's only colour — singular and deliberate."
      },
      "accentForeground": { "$value": "#0C0C0C" },
      "destructive": { "$value": "#D63030", "$description": "Alert red." },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#DEDEDE" },
      "ring": { "$value": "#0C0C0C" },
      "chart1": { "$value": "#0C0C0C", "$description": "Black — primary data series." },
      "chart2": { "$value": "#B0AAB8", "$description": "Accent lavender." },
      "chart3": { "$value": "#6E6E6E", "$description": "Mid grey." },
      "chart4": { "$value": "#D63030", "$description": "Alert red." },
      "chart5": { "$value": "#ABABAB", "$description": "Light grey." },
      "sidebar": { "$value": "#0C0C0C", "$description": "Black sidebar — drama and authority." },
      "sidebarForeground": { "$value": "#F5F5F5" },
      "sidebarBorder": { "$value": "#252525" },
      "sidebarPrimary": { "$value": "#B0AAB8", "$description": "Accent lavender as sidebar highlight." },
      "sidebarPrimaryForeground": { "$value": "#0C0C0C" },
      "sidebarAccent": { "$value": "#1C1C1C" },
      "sidebarAccentForeground": { "$value": "#F5F5F5" },
      "sidebarRing": { "$value": "#B0AAB8" }
    },
    "dark": {
      "background": { "$value": "#0C0C0C", "$description": "Near-black ground." },
      "foreground": { "$value": "#F2F2F2", "$description": "Off-white text." },
      "border": { "$value": "#2C2C2C", "$description": "Dark cold grey border." },
      "card": { "$value": "#161616", "$description": "Slightly elevated dark card." },
      "cardForeground": { "$value": "#F2F2F2" },
      "popover": { "$value": "#161616" },
      "popoverForeground": { "$value": "#F2F2F2" },
      "primary": { "$value": "#F2F2F2", "$description": "Off-white as primary in dark — inverted authority." },
      "primaryForeground": { "$value": "#0C0C0C" },
      "secondary": { "$value": "#202020", "$description": "Dark secondary surface." },
      "secondaryForeground": { "$value": "#F2F2F2" },
      "muted": { "$value": "#282828", "$description": "Dark muted surface." },
      "mutedForeground": { "$value": "#8A8A8A", "$description": "Cold grey muted text." },
      "accent": {
        "$value": "#7A7482",
        "$description": "Deeper cold lavender-steel. Same hue as light, less luminance."
      },
      "accentForeground": { "$value": "#F2F2F2" },
      "destructive": { "$value": "#E04545" },
      "destructiveForeground": { "$value": "#0C0C0C" },
      "input": { "$value": "#2C2C2C" },
      "ring": { "$value": "#F2F2F2" },
      "chart1": { "$value": "#F2F2F2", "$description": "Off-white — primary data series." },
      "chart2": { "$value": "#7A7482", "$description": "Dark accent lavender." },
      "chart3": { "$value": "#8A8A8A", "$description": "Cold grey." },
      "chart4": { "$value": "#E04545", "$description": "Alert red." },
      "chart5": { "$value": "#505050", "$description": "Dark grey." },
      "sidebar": { "$value": "#080808", "$description": "Deepest black sidebar." },
      "sidebarForeground": { "$value": "#F2F2F2" },
      "sidebarBorder": { "$value": "#1E1E1E" },
      "sidebarPrimary": { "$value": "#7A7482" },
      "sidebarPrimaryForeground": { "$value": "#F2F2F2" },
      "sidebarAccent": { "$value": "#1A1A1A" },
      "sidebarAccentForeground": { "$value": "#F2F2F2" },
      "sidebarRing": { "$value": "#7A7482" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Jost", "sans-serif"],
        "$description": "Jost — geometric grotesque, free Futura substitute. The only typeface in the system. Weight 100 for monumental display; 400 for body; 600–700 for emphasis. No other typeface."
      },
      "serif": {
        "$value": ["Jost", "sans-serif"],
        "$description": "Jost — single-typeface system. Serif role also uses Jost; contrast comes from weight and scale, not from a different family."
      },
      "mono": {
        "$value": ["JetBrains Mono", "monospace"],
        "$description": "JetBrains Mono — clean technical mono. Used for formulas, CAS numbers, lab data, and code only."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0rem",
      "$description": "Zero radius. No softening. Every edge is a statement."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step."
    }
  }
}
