{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "S1 Design System — Sillage Lab. Industrial cool-lab aesthetic. CDG × Acne Studio × Arpa Studios. Edit values here only; never hand-edit the generated src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F2F1EF", "$description": "Concrete beige-grey. The ground." },
      "foreground": { "$value": "#131416", "$description": "Near-black with cool undertone." },
      "border": { "$value": "#D6D9E2", "$description": "Cool grey-blue border." },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#131416" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#131416" },
      "primary": {
        "$value": "#131416",
        "$description": "Near-black. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#F2F1EF" },
      "secondary": { "$value": "#E5E7ED", "$description": "Cool grey-blue, light." },
      "secondaryForeground": { "$value": "#131416" },
      "muted": { "$value": "#DCDFE6", "$description": "Slightly deeper grey-blue surface." },
      "mutedForeground": { "$value": "#74788A", "$description": "Mid grey-blue text." },
      "accent": {
        "$value": "#EFC84A",
        "$description": "German Yellow. Bauhaus / Porsche signal yellow. The system's only warm note."
      },
      "accentForeground": { "$value": "#131416" },
      "destructive": { "$value": "#C43030" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#D6D9E2" },
      "ring": { "$value": "#131416" },
      "chart1": { "$value": "#EFC84A", "$description": "German Yellow — primary data series." },
      "chart2": { "$value": "#131416", "$description": "Near-black." },
      "chart3": { "$value": "#74788A", "$description": "Grey-blue mid." },
      "chart4": { "$value": "#C43030", "$description": "Alert red." },
      "chart5": { "$value": "#4A6080", "$description": "Slate blue." },
      "sidebar": { "$value": "#0C0D0F", "$description": "Deep black sidebar." },
      "sidebarForeground": { "$value": "#E5E7ED" },
      "sidebarBorder": { "$value": "#22252B" },
      "sidebarPrimary": { "$value": "#EFC84A", "$description": "Yellow highlight in dark sidebar." },
      "sidebarPrimaryForeground": { "$value": "#0C0D0F" },
      "sidebarAccent": { "$value": "#191C22" },
      "sidebarAccentForeground": { "$value": "#E5E7ED" },
      "sidebarRing": { "$value": "#EFC84A" }
    },
    "dark": {
      "background": { "$value": "#0C0D0F", "$description": "Deep cool near-black." },
      "foreground": { "$value": "#E5E7ED" },
      "border": { "$value": "#22252B" },
      "card": { "$value": "#141619", "$description": "Dark blue-grey card surface." },
      "cardForeground": { "$value": "#E5E7ED" },
      "popover": { "$value": "#141619" },
      "popoverForeground": { "$value": "#E5E7ED" },
      "primary": { "$value": "#E5E7ED" },
      "primaryForeground": { "$value": "#0C0D0F" },
      "secondary": { "$value": "#1C1F27", "$description": "Dark blue-grey." },
      "secondaryForeground": { "$value": "#E5E7ED" },
      "muted": { "$value": "#22252D" },
      "mutedForeground": { "$value": "#8C909C" },
      "accent": {
        "$value": "#EFC84A",
        "$description": "German Yellow — unchanged in dark. It holds."
      },
      "accentForeground": { "$value": "#0C0D0F" },
      "destructive": { "$value": "#D64040" },
      "destructiveForeground": { "$value": "#0C0D0F" },
      "input": { "$value": "#22252B" },
      "ring": { "$value": "#E5E7ED" },
      "chart1": { "$value": "#EFC84A" },
      "chart2": { "$value": "#E5E7ED" },
      "chart3": { "$value": "#8C909C" },
      "chart4": { "$value": "#D64040" },
      "chart5": { "$value": "#5A7899" },
      "sidebar": { "$value": "#080910", "$description": "Deepest black." },
      "sidebarForeground": { "$value": "#E5E7ED" },
      "sidebarBorder": { "$value": "#191C22" },
      "sidebarPrimary": { "$value": "#EFC84A" },
      "sidebarPrimaryForeground": { "$value": "#080910" },
      "sidebarAccent": { "$value": "#141619" },
      "sidebarAccentForeground": { "$value": "#E5E7ED" },
      "sidebarRing": { "$value": "#EFC84A" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Jost", "sans-serif"],
        "$description": "Jost — geometric grotesque, the closest free match to Futura PT. Chanel-coded, industrial precision."
      },
      "serif": {
        "$value": ["Bodoni Moda", "serif"],
        "$description": "Bodoni Moda — extreme stroke contrast. Fashion-forward, ultra-luxury editorial."
      },
      "mono": {
        "$value": ["DM Mono", "monospace"],
        "$description": "DM Mono — clean, neutral. Used for CAS numbers, formulas, lab data."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0rem",
      "$description": "Zero radius. Sharp industrial edges — no softening."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step."
    }
  }
}
