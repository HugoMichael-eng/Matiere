      "cardForeground": { "$value": "#DFDDD9" },
      "popover": { "$value": "#292927" },
      "popoverForeground": { "$value": "#DFDDD9" },
      "primary": { "$value": "#DFDDD9" },
      "primaryForeground": { "$value": "#1A1A1A" },
      "secondary": { "$value": "#353432" },
      "secondaryForeground": { "$value": "#DFDDD9" },
      "muted": { "$value": "#2D2C2A" },
      "mutedForeground": { "$value": "#AAA8A3" },
      "accent": { "$value": "#565552" },
      "accentForeground": { "$value": "#F0EEEA" },
      "destructive": { "$value": "#9B4A4A" },
      "destructiveForeground": { "$value": "#FFF8F5" },
      "input": { "$value": "#565552" },
      "ring": { "$value": "#DFDDD9" },
      "chart1": { "$value": "#DFDDD9" },
      "chart2": { "$value": "#B9B7B3" },
      "chart3": { "$value": "#92908B" },
      "chart4": { "$value": "#6D6B67" },
