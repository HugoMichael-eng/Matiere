{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "MATIÈRE experiential design tokens. The selected Verve mockup supplies structural restraint and editorial scale; the MATIÈRE redesign brief adds warm gallery light, a sparse acid-citron accent, tactile creative surfaces, and a precise laboratory mode. THIS FILE IS THE SINGLE SOURCE OF TRUTH.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F1EFE9" },
      "foreground": { "$value": "#24231F" },
      "border": { "$value": "#C7C3B9" },
      "card": { "$value": "#F7F5F0" },
      "cardForeground": { "$value": "#24231F" },
      "popover": { "$value": "#FCFAF5" },
      "popoverForeground": { "$value": "#24231F" },
      "primary": {
        "$value": "#24231F",
        "$description": "Near-black charcoal for decisive controls, display type, and technical hierarchy."
      },
      "primaryForeground": { "$value": "#F1EFE9" },
      "secondary": { "$value": "#E3E0D8" },
      "secondaryForeground": { "$value": "#24231F" },
      "muted": { "$value": "#E9E6DE" },
      "mutedForeground": { "$value": "#6D6A62" },
      "accent": {
        "$value": "#D9FF43",
        "$description": "Signature acid citron. Restrict to active states, selection, connection points, drag targets, AI markers, and focus."
      },
      "accentForeground": { "$value": "#171812" },
      "destructive": { "$value": "#6B2525" },
      "destructiveForeground": { "$value": "#F4F2EE" },
      "input": { "$value": "#B9B5AB" },
      "ring": { "$value": "#D9FF43" },
      "chart1": { "$value": "#D9FF43" },
      "chart2": { "$value": "#667465" },
      "chart3": { "$value": "#8A7F72" },
      "chart4": { "$value": "#AEB4AE" },
      "chart5": { "$value": "#4E514A" },
      "sidebar": { "$value": "#E8E5DD" },
      "sidebarForeground": { "$value": "#24231F" },
      "sidebarBorder": { "$value": "#C7C3B9" },
      "sidebarPrimary": { "$value": "#24231F" },
      "sidebarPrimaryForeground": { "$value": "#F1EFE9" },
      "sidebarAccent": { "$value": "#D9FF43" },
      "sidebarAccentForeground": { "$value": "#171812" },
      "sidebarRing": { "$value": "#D9FF43" }
    },
    "dark": {
      "background": { "$value": "#12120F" },
      "foreground": { "$value": "#F1EFE9" },
      "border": { "$value": "#41413A" },
      "card": { "$value": "#1A1A17" },
      "cardForeground": { "$value": "#F1EFE9" },
      "popover": { "$value": "#20201C" },
      "popoverForeground": { "$value": "#F1EFE9" },
      "primary": { "$value": "#F1EFE9" },
      "primaryForeground": { "$value": "#171812" },
      "secondary": { "$value": "#30302A" },
      "secondaryForeground": { "$value": "#F1EFE9" },
      "muted": { "$value": "#272722" },
      "mutedForeground": { "$value": "#AAA79F" },
      "accent": { "$value": "#D9FF43" },
      "accentForeground": { "$value": "#171812" },
      "destructive": { "$value": "#9B4A4A" },
      "destructiveForeground": { "$value": "#FFF8F5" },
      "input": { "$value": "#505048" },
      "ring": { "$value": "#D9FF43" },
      "chart1": { "$value": "#D9FF43" },
      "chart2": { "$value": "#AEB4AE" },
      "chart3": { "$value": "#8A9A83" },
      "chart4": { "$value": "#B8AA9A" },
      "chart5": { "$value": "#73766F" },
      "sidebar": { "$value": "#0D0D0B" },
      "sidebarForeground": { "$value": "#F1EFE9" },
      "sidebarBorder": { "$value": "#41413A" },
      "sidebarPrimary": { "$value": "#F1EFE9" },
      "sidebarPrimaryForeground": { "$value": "#171812" },
      "sidebarAccent": { "$value": "#D9FF43" },
      "sidebarAccentForeground": { "$value": "#171812" },
      "sidebarRing": { "$value": "#D9FF43" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Compact editorial body copy and structural labels."
      },
      "serif": {
        "$value": ["Bricolage Grotesque", "sans-serif"],
        "$description": "Oversized display face; intentionally assigned to the display slot despite being a grotesque."
      },
      "mono": { "$value": ["IBM Plex Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0rem",
      "$description": "Hard, architectural corners throughout. Circular controls are explicit exceptions."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
