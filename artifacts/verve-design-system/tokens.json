      "sidebarPrimary": { "$value": "#1A1A1A" },
      "sidebarPrimaryForeground": { "$value": "#DFDDD9" },
      "sidebarAccent": { "$value": "#C9C7C3" },
      "sidebarAccentForeground": { "$value": "#1A1A1A" },
      "sidebarRing": { "$value": "#1A1A1A" }
