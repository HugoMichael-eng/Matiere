      "secondary": { "$value": "#C9C7C3" },
      "secondaryForeground": { "$value": "#1A1A1A" },
      "muted": { "$value": "#D5D3CF" },
      "mutedForeground": { "$value": "#696763" },
      "accent": { "$value": "#A8A6A2" },
